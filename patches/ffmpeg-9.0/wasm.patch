+static int wasm_timeout_ms = -1;
+static int64_t wasm_deadline = INT64_MAX;
+
+void ffmpeg_wasm_set_timeout(int timeout_ms);
+void ffmpeg_wasm_begin(void);
+int ffmpeg_wasm_cancelled(void);
+
+void ffmpeg_wasm_set_timeout(int timeout_ms)
+{
+    wasm_timeout_ms = timeout_ms;
+}
+
+void ffmpeg_wasm_begin(void)
+{
+    wasm_deadline = wasm_timeout_ms < 0 ? INT64_MAX :
+        av_gettime_relative() + (int64_t)wasm_timeout_ms * 1000;
+}
+
+int ffmpeg_wasm_cancelled(void)
+{
+    return av_gettime_relative() >= wasm_deadline;
+}
+
 static int ffmpeg_runtime_cancel_requested(void)
 {
+    if (ffmpeg_wasm_cancelled())
+        return 1;
     return ffmpeg_runtime_active_session &&
            atomic_load(&ffmpeg_runtime_active_session->cancel_requested);
 }
 
