+static void ffmpeg_runtime_log(void *context, int level, const char *format, va_list args)
+{
+    char line[1024];
+    int prefix = 1;
+    size_t length;
+
+    if (level > AV_LOG_WARNING || level > av_log_get_level())
+        return;
+    av_log_format_line2(context, level, format, args, line, sizeof(line), &prefix);
+    length = strlen(line);
+
+    pthread_mutex_lock(&ffmpeg_runtime_log_mutex);
+    FfmpegSession *session = ffmpeg_runtime_active_session;
+    if (session) {
+        const size_t capacity = sizeof(session->output) - 1;
+        if (session->output_length + length > capacity) {
+            const size_t drop = session->output_length + length - capacity;
+            memmove(session->output, session->output + drop,
+                    session->output_length - drop);
+            session->output_length -= drop;
+        }
+        memcpy(session->output + session->output_length, line, length);
+        session->output_length += length;
+        session->output[session->output_length] = 0;
+    }
+    pthread_mutex_unlock(&ffmpeg_runtime_log_mutex);
+}
+
+static void ffmpeg_runtime_install_logging(void)
+{
+    av_log_set_callback(ffmpeg_runtime_log);
+}
+
+void ffmpeg_runtime_init_logging(void)
+{
+    pthread_once(&ffmpeg_runtime_log_once, ffmpeg_runtime_install_logging);
+}
+
+const char *ffmpeg_session_output(FfmpegSession *session)
+{
+    return session->output;
+}
+
+FfmpegSession *ffmpeg_session_new(ffmpeg_progress_callback progress_cb,
+                                          void *progress_opaque)
+{
+    FfmpegSession *session = calloc(1, sizeof(*session));
+
+    if (!session)
+        return NULL;
+
+    atomic_init(&session->cancel_requested, 0);
+    session->progress_cb = progress_cb;
+    session->progress_opaque = progress_opaque;
+    return session;
+}
+
+void ffmpeg_session_free(FfmpegSession *session)
+{
+    free(session);
+}
+
+void ffmpeg_cancel(FfmpegSession *session)
+{
+    if (session)
+        atomic_store(&session->cancel_requested, 1);
+}
+
+static int ffmpeg_runtime_cancel_requested(void)
+{
+    return ffmpeg_runtime_active_session &&
+           atomic_load(&ffmpeg_runtime_active_session->cancel_requested);
+}
+
+static void ffmpeg_runtime_forward_progress(int64_t pts, int is_final)
+{
+    FfmpegSession *session = ffmpeg_runtime_active_session;
+
+    if (!session || !session->progress_cb)
+        return;
+    if (pts == AV_NOPTS_VALUE)
+        return;
+    if (atomic_load(&session->cancel_requested))
+        return;
+    session->progress_cb(session->progress_opaque, pts, is_final);
+}
